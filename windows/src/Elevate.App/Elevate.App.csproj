<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RootNamespace>Elevate.App</RootNamespace>
    <AssemblyName>Elevate</AssemblyName>
    <!-- Overridden by installer/build.ps1 (-p:Version) from the windows-v* tag. -->
    <Version>1.0.0</Version>
    <Company>Reothor</Company>
    <Product>Elevate</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;arm64</Platforms>
    <!-- A direct `dotnet build` of this project has no solution platform; WinUI cannot target AnyCPU. -->
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$(Platform.ToLowerInvariant())</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ApplicationIcon>Assets\Elevate.ico</ApplicationIcon>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- Program.Main hosts the single-instance check; the XAML-generated entry point is disabled. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- Generated XAML/CsWin32 code and the WinRT projections raise analyzer warnings we cannot fix here. -->
    <NoWarn>$(NoWarn);CA1416;CA1812;CA1852;CA2000;CA1001;CS8632;CsWinRT1028;CsWinRT1030</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.333">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Elevate.App.Model\Elevate.App.Model.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
