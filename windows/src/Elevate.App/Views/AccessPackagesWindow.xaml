<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Elevate.App.Views.AccessPackagesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Elevate.App.Views">
    <Grid x:Name="Root" Padding="22,6,22,18" RowSpacing="10">
        <Grid.Resources>
            <!-- One package, request or assignment: name and caption, a state pill, and at most one button. -->
            <DataTemplate x:Key="PackageRowTemplate" x:DataType="views:PackageRow">
                <Grid ColumnSpacing="10" Padding="0,6" MinHeight="44"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{x:Bind Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Detail}" Visibility="{x:Bind DetailVisibility}" FontSize="12" MaxLines="2"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   ToolTipService.ToolTip="{x:Bind Detail}" />
                    </StackPanel>
                    <views:Pill Grid.Column="1" Text="{x:Bind StateText}" Tint="{x:Bind StateTint}" Visibility="{x:Bind StateVisibility}" />
                    <Button Grid.Column="2" Content="{x:Bind ButtonText}" Style="{x:Bind ButtonStyle}" Visibility="{x:Bind ButtonVisibility}"
                            IsEnabled="{x:Bind ButtonEnabled}" Click="OnRowButton" VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Packages you can request through Entra entitlement management. Approvals and delivery happen in Entra."
                   FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <SelectorBar Grid.Row="1" x:Name="Tabs" SelectionChanged="OnTabChanged">
            <SelectorBarItem x:Name="AvailableTab" Text="Available" IsSelected="True" />
            <SelectorBarItem x:Name="RequestedTab" Text="Requested" />
            <SelectorBarItem x:Name="AssignedTab" Text="Assigned" />
            <SelectorBarItem x:Name="DeclinedTab" Text="Declined" />
        </SelectorBar>

        <TextBox Grid.Row="2" x:Name="Search" PlaceholderText="Search packages" TextChanged="OnSearchChanged" AutomationProperties.Name="Search packages" />

        <Grid Grid.Row="3">
            <ListView x:Name="List" SelectionMode="None" IsItemClickEnabled="False" ItemTemplate="{StaticResource PackageRowTemplate}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="4,0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
            <!-- One line per tab when there is nothing to list, or nothing matching the search. -->
            <TextBlock x:Name="Empty" Visibility="Collapsed" FontSize="12" TextWrapping="Wrap" Margin="4,8,4,0" VerticalAlignment="Top"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <!-- The permission was refused or withdrawn: the lists give way to the reason and the consent link. -->
            <StackPanel x:Name="Consent" Visibility="Collapsed" Spacing="6" Margin="4,8,4,0" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Access packages are not permitted in this tenant." VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="ConsentDetail" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <HyperlinkButton x:Name="ConsentLink" Content="Open admin consent link…" Click="OnConsentLink" Padding="0" Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <InfoBar Grid.Row="4" x:Name="Error" IsOpen="False" IsClosable="True" Severity="Error" />

        <Grid Grid.Row="5" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="RefreshButton" Click="OnRefresh" Width="36" Height="32" Padding="0" AutomationProperties.Name="Refresh"
                    ToolTipService.ToolTip="Refresh">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
            <TextBlock Grid.Column="1" x:Name="Updated" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ProgressRing Grid.Column="2" x:Name="Working" Width="16" Height="16" IsActive="False" Visibility="Collapsed" VerticalAlignment="Center" />
            <Button Grid.Column="4" Content="Close" Click="OnClose" MinWidth="90" />
        </Grid>
    </Grid>
</Window>
