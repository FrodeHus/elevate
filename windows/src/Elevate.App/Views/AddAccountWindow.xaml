<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Elevate.App.Views.AddAccountWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Padding="22,6,22,22" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Add account" FontSize="18" FontWeight="SemiBold" />

        <StackPanel Grid.Row="1" x:Name="Choices" Spacing="8">
            <RadioButton x:Name="OwnAppChoice" GroupName="method" Checked="OnChoiceChanged">
                <StackPanel>
                    <TextBlock Text="Your app registration" FontWeight="SemiBold" />
                    <TextBlock x:Name="OwnAppCaption" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="CustomChoice" GroupName="method" Checked="OnChoiceChanged">
                <StackPanel>
                    <TextBlock Text="Custom client ID" FontWeight="SemiBold" />
                    <TextBlock Text="A company multi-tenant registration without the WAM redirect; signs in through the system browser on http://localhost."
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </RadioButton>
            <StackPanel x:Name="CustomRow" Margin="28,0,0,0" Spacing="4" Visibility="Collapsed">
                <TextBox x:Name="CustomClientId" PlaceholderText="Application (client) ID" FontFamily="Cascadia Mono, Consolas" TextChanged="OnCustomChanged" />
                <TextBlock x:Name="CustomHint" Text="Enter the application (client) ID as a GUID" FontSize="12"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="Collapsed" />
            </StackPanel>
            <RadioButton x:Name="CliChoice" GroupName="method" Checked="OnChoiceChanged">
                <StackPanel>
                    <TextBlock Text="Azure CLI app" FontWeight="SemiBold" />
                    <TextBlock Text="Microsoft's Azure CLI app; no consent needed. Supports activation of Azure resource roles only."
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="PowerShellChoice" GroupName="method" Checked="OnChoiceChanged">
                <StackPanel>
                    <TextBlock Text="Azure PowerShell app" FontWeight="SemiBold" />
                    <TextBlock Text="For tenants that block the Azure CLI app. Supports activation of Azure resource roles only."
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </RadioButton>
        </StackPanel>

        <InfoBar Grid.Row="2" x:Name="Limits" IsOpen="True" IsClosable="False" Severity="Informational" />

        <InfoBar Grid.Row="3" x:Name="Error" IsOpen="False" IsClosable="False" Severity="Error" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <ProgressRing x:Name="Working" Width="20" Height="20" IsActive="False" Visibility="Collapsed" VerticalAlignment="Center" />
            <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" MinWidth="90" />
            <Button x:Name="ContinueButton" Content="Continue" Style="{StaticResource AccentButtonStyle}" Click="OnContinue" MinWidth="110" />
        </StackPanel>
    </Grid>
</Window>
