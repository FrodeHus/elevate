<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Elevate.App.Views.TenantWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Elevate.App.Views">
    <Grid x:Name="Root" Padding="22,6,22,22" RowSpacing="12">
        <Grid.Resources>
            <!-- One tenant found by Azure Resource Manager in the Discover tenants checklist. -->
            <DataTemplate x:Key="DiscoveredTemplate" x:DataType="views:DiscoveredItem">
                <Grid ColumnSpacing="10" Padding="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" MinWidth="0" Padding="0" IsChecked="{x:Bind Chosen, Mode=TwoWay}" IsEnabled="{x:Bind Enabled}" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind DisplayName}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind DisplayName}" />
                        <TextBlock Text="{x:Bind Caption}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" x:Name="Heading" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />

        <!-- Add tenant -->
        <StackPanel Grid.Row="1" x:Name="AddPane" Spacing="6" Visibility="Collapsed">
            <TextBlock Text="Tenant id or verified domain" FontSize="13" />
            <TextBox x:Name="Input" PlaceholderText="e.g. fabrikam.com" TextChanged="OnInputChanged" />
        </StackPanel>

        <!-- Discover tenants -->
        <Grid Grid.Row="1" x:Name="DiscoverPane" Visibility="Collapsed">
            <StackPanel x:Name="Loading" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top">
                <ProgressRing Width="20" Height="20" IsActive="True" />
                <TextBlock Text="Asking Azure Resource Manager…" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <ListView x:Name="Found" SelectionMode="None" IsItemClickEnabled="False" Visibility="Collapsed" CornerRadius="4"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1"
                      ItemTemplate="{StaticResource DiscoveredTemplate}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Grid>

        <InfoBar Grid.Row="2" x:Name="Error" IsOpen="False" IsClosable="False" Severity="Error" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <ProgressRing x:Name="Working" Width="20" Height="20" IsActive="False" Visibility="Collapsed" VerticalAlignment="Center" />
            <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" MinWidth="90" />
            <Button x:Name="PrimaryButton" Style="{StaticResource AccentButtonStyle}" Click="OnPrimary" MinWidth="120" />
        </StackPanel>
    </Grid>
</Window>
