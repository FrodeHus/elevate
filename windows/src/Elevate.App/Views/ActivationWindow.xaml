<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Elevate.App.Views.ActivationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Elevate.App.Views">
    <Grid x:Name="Root" Padding="22,6,22,22" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="Subtitle" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- Single role: one duration picker; bulk: a table with one row per role -->
        <StackPanel Grid.Row="1" x:Name="SinglePane" Spacing="8">
            <InfoBar x:Name="SingleError" IsOpen="False" IsClosable="False" Severity="Error" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Duration" VerticalAlignment="Center" FontSize="13" />
                <views:DurationPicker x:Name="SingleDuration" />
            </StackPanel>
            <TextBlock x:Name="SingleApproval" Text="This role requires approval; it will not be active until an approver decides." FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="2" x:Name="BulkPane" Visibility="Collapsed" CornerRadius="4"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel x:Name="BulkRows" />
        </Border>

        <!-- Start at -->
        <StackPanel Grid.Row="3" x:Name="ScheduleRow" Orientation="Horizontal" Spacing="12">
            <ToggleSwitch x:Name="ScheduleToggle" Header="" OnContent="Start at" OffContent="Start now" Toggled="OnScheduleToggled" MinWidth="0" />
            <DatePicker x:Name="StartDate" Visibility="Collapsed" />
            <TimePicker x:Name="StartTime" Visibility="Collapsed" MinuteIncrement="5" />
        </StackPanel>

        <!-- Reason -->
        <StackPanel Grid.Row="4" Spacing="6">
            <TextBlock Text="Reason" FontSize="13" />
            <TextBox x:Name="Reason" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="120" TextChanged="OnInputChanged"
                     PlaceholderText="Why you need this access" />
        </StackPanel>

        <!-- Ticket, when a policy demands it -->
        <Grid Grid.Row="5" x:Name="TicketRow" Visibility="Collapsed" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock Text="Ticket number" FontSize="13" />
                <TextBox x:Name="TicketNumber" TextChanged="OnInputChanged" PlaceholderText="Required by policy" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Text="Ticket system" FontSize="13" />
                <TextBox x:Name="TicketSystem" PlaceholderText="e.g. ServiceNow" />
            </StackPanel>
        </Grid>

        <InfoBar Grid.Row="6" x:Name="Failure" IsOpen="False" IsClosable="False" Severity="Error" />

        <StackPanel Grid.Row="7" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <ProgressRing x:Name="Running" Width="20" Height="20" IsActive="False" Visibility="Collapsed" VerticalAlignment="Center" />
            <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" MinWidth="90" />
            <Button x:Name="SubmitButton" Content="Activate" Style="{StaticResource AccentButtonStyle}" Click="OnSubmit" MinWidth="120" />
        </StackPanel>
    </Grid>
</Window>
