<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Elevate.App.Views.ConfigureRolesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Elevate.App.Views">
    <Grid x:Name="Root" Padding="22,6,22,22" RowSpacing="10">
        <Grid.Resources>
            <!-- One built-in Entra role in the Configure known roles checklist. -->
            <DataTemplate x:Key="CatalogueTemplate" x:DataType="views:CatalogueItem">
                <Grid ColumnSpacing="10" Padding="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" MinWidth="0" Padding="0" IsChecked="{x:Bind Selected, Mode=TwoWay}" VerticalAlignment="Top" AutomationProperties.Name="{x:Bind DisplayName}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{x:Bind DisplayName}" />
                        <TextBlock Text="{x:Bind Description}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="2" Visibility="{x:Bind PrivilegedVisibility}" CornerRadius="9" Padding="7,1" VerticalAlignment="Top" Margin="0,2,0,0"
                            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}">
                        <TextBlock Text="Privileged" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    </Border>
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="Discovery is refused in this tenant. Choose the roles you are eligible for; Elevate will try to activate them directly."
                       FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <SelectorBar Grid.Row="1" x:Name="Sections" SelectionChanged="OnSectionChanged">
            <SelectorBarItem x:Name="EntraSection" Text="Entra roles" />
            <SelectorBarItem x:Name="AzureSection" Text="Azure resources" />
            <SelectorBarItem x:Name="GroupsSection" Text="Groups" />
        </SelectorBar>

        <!-- Entra: searchable catalogue checklist -->
        <Grid Grid.Row="2" x:Name="EntraPane" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBox Grid.Row="0" x:Name="Search" PlaceholderText="Search built-in roles" TextChanged="OnSearchChanged" />
            <ListView Grid.Row="1" x:Name="Catalogue" SelectionMode="None" IsItemClickEnabled="False" CornerRadius="4"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1"
                      ItemTemplate="{StaticResource CatalogueTemplate}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Grid>

        <!-- Azure: scope + role name rows -->
        <Grid Grid.Row="2" x:Name="AzurePane" Visibility="Collapsed" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Scope is the full resource id, e.g. /subscriptions/&lt;id&gt; or /subscriptions/&lt;id&gt;/resourceGroups/&lt;name&gt;."
                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <ScrollViewer Grid.Row="1" CornerRadius="4" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel x:Name="AzureRows" Padding="8" Spacing="6" />
            </ScrollViewer>
            <Button Grid.Row="2" Content="Add row" Click="OnAddAzureRow" />
        </Grid>

        <!-- Groups: id + name + access rows -->
        <Grid Grid.Row="2" x:Name="GroupsPane" Visibility="Collapsed" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" CornerRadius="4" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel x:Name="GroupRows" Padding="8" Spacing="6" />
            </ScrollViewer>
            <Button Grid.Row="1" Content="Add row" Click="OnAddGroupRow" />
            <TextBlock Grid.Row="2" Text="The group id is the group's object id in Entra ID." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="Summary" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Cancel" Click="OnCancel" MinWidth="90" />
            <Button Grid.Column="2" x:Name="SaveButton" Content="Save" Style="{StaticResource AccentButtonStyle}" Click="OnSave" MinWidth="110" />
        </Grid>
    </Grid>
</Window>
