<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Elevate.App.Views.PanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Elevate.App.Views"
    Width="380">
    <UserControl.Resources>
        <CollectionViewSource x:Name="GroupedSource" IsSourceGrouped="True" />

        <!-- One eligible role, or one active assignment in the summary. -->
        <DataTemplate x:Key="RoleRowTemplate" x:DataType="views:RoleRow">
            <!-- A role added since the last discovery gets a faint accent tint; the "new" badge carries the meaning. -->
            <Grid MinHeight="44" Padding="14,6,14,6" ColumnSpacing="10" Background="{x:Bind RowBrush, Mode=OneWay}"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" MinWidth="0" Padding="0" Margin="0,0,-4,0" VerticalAlignment="Center"
                          Visibility="{x:Bind SelectVisibility, Mode=OneWay}" IsChecked="{x:Bind Selected, Mode=OneWay}"
                          IsEnabled="{x:Bind SelectEnabled, Mode=OneWay}" Click="OnSelectClick"
                          ToolTipService.ToolTip="{x:Bind ViewOnlyReason, Mode=OneWay}" AutomationProperties.Name="{x:Bind SelectLabel, Mode=OneWay}" />
                <views:StatusDot Grid.Column="1" Status="{x:Bind Status, Mode=OneWay}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                    <!-- One line with trimming, in select mode too; the tenant · account caption below keeps the 12 px caption size. -->
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontSize="14" VerticalAlignment="Center" />
                        <views:Pill Text="new" Tint="Accent" Visibility="{x:Bind NewVisibility, Mode=OneWay}" Tooltip="Added since the last discovery" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Visibility="{x:Bind DetailVisibility, Mode=OneWay}"
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{x:Bind DetailTooltip, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind Via, Mode=OneWay}" Visibility="{x:Bind ViaVisibility, Mode=OneWay}"
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="This eligibility is granted through a group; activating it activates the role for you" />
                    <TextBlock Text="manual" Visibility="{x:Bind ManualVisibility, Mode=OneWay}"
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind PolicyNotes, Mode=OneWay}" Visibility="{x:Bind PolicyVisibility, Mode=OneWay}"
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{x:Bind PolicyTooltip, Mode=OneWay}" AutomationProperties.Name="Policy" />
                    <TextBlock Text="{x:Bind FailedText, Mode=OneWay}" Visibility="{x:Bind FailedVisibility, Mode=OneWay}"
                               FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{x:Bind FailedText, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- "2 h 41 min" in the body face; a minimum width keeps the buttons aligned across rows now that the text no longer lines up on its own. -->
                    <TextBlock Text="{x:Bind Countdown, Mode=OneWay}" Visibility="{x:Bind CountdownVisibility, Mode=OneWay}"
                               FontSize="13" MinWidth="64" TextAlignment="Right" VerticalAlignment="Center"
                               Foreground="{x:Bind CountdownBrush, Mode=OneWay}"
                               FontWeight="{x:Bind CountdownWeight, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Visibility="{x:Bind StatusTextVisibility, Mode=OneWay}"
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <ProgressRing Width="16" Height="16" IsActive="True" Visibility="{x:Bind ProvisioningVisibility, Mode=OneWay}" />
                    <TextBlock Text="cannot activate" Visibility="{x:Bind ViewOnlyVisibility, Mode=OneWay}" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                               ToolTipService.ToolTip="{x:Bind ViewOnlyReason, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <ProgressRing Width="16" Height="16" IsActive="True" Visibility="{x:Bind InFlightVisibility, Mode=OneWay}"
                                  ToolTipService.ToolTip="Request in progress" />
                    <Button Content="Extend" Style="{StaticResource SmallButtonStyle}" Visibility="{x:Bind ExtendVisibility, Mode=OneWay}"
                            IsEnabled="{x:Bind ExtendEnabled, Mode=OneWay}" Click="OnExtendClick"
                            ToolTipService.ToolTip="Extend by activating again; Ctrl-click to extend with the last reason" />
                    <Button Content="Deactivate" Style="{StaticResource SmallButtonStyle}" Visibility="{x:Bind DeactivateVisibility, Mode=OneWay}"
                            IsEnabled="{x:Bind DeactivateEnabled, Mode=OneWay}" Click="OnDeactivateClick"
                            ToolTipService.ToolTip="{x:Bind DeactivateTooltip, Mode=OneWay}" />
                    <Button Content="Cancel" Style="{StaticResource SmallButtonStyle}" Visibility="{x:Bind CancelVisibility, Mode=OneWay}"
                            IsEnabled="{x:Bind CancelEnabled, Mode=OneWay}" Click="OnDeactivateClick"
                            ToolTipService.ToolTip="Cancel this scheduled activation" />
                    <Button Content="Cancel" Style="{StaticResource SmallButtonStyle}" Visibility="{x:Bind CancelPendingVisibility, Mode=OneWay}"
                            IsEnabled="{x:Bind CancelEnabled, Mode=OneWay}" Click="OnCancelPendingClick"
                            ToolTipService.ToolTip="Withdraw this request" />
                    <!-- The one prominent control in a row: Activate, or Request when an approver must accept it. Deactivate stays quiet. -->
                    <Button Content="{x:Bind ActivateText, Mode=OneWay}" Style="{StaticResource SmallAccentButtonStyle}" Visibility="{x:Bind ActivateVisibility, Mode=OneWay}"
                            IsEnabled="{x:Bind ActivateEnabled, Mode=OneWay}" Click="OnActivateClick"
                            ToolTipService.ToolTip="{x:Bind ActivateTooltip, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="NoteRowTemplate" x:DataType="views:NoteRow">
            <Grid Margin="28,6,14,6" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Bind Text, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <!-- "No roles configured." for a manual-roles tenant offers the fix in place rather than two clicks away in the tenant menu. -->
                <HyperlinkButton Grid.Column="1" Content="Configure…" Visibility="{x:Bind ConfigureVisibility, Mode=OneWay}" Click="OnNoteConfigure"
                                 FontSize="12" Padding="4,0" VerticalAlignment="Center" ToolTipService.ToolTip="Choose the PIM roles you are eligible for in this tenant" />
            </Grid>
        </DataTemplate>

        <!-- One request awaiting this user's decision, in the pinned "Approvals" group. -->
        <DataTemplate x:Key="ApprovalRowTemplate" x:DataType="views:ApprovalRow">
            <StackPanel Padding="14,6,14,6" Spacing="2" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                        ToolTipService.ToolTip="{x:Bind Justification, Mode=OneWay}">
                <Grid MinHeight="32" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE823;" FontSize="14" Foreground="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{x:Bind RequesterName, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Target, Mode=OneWay}" FontSize="13" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Caption, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <ProgressRing Width="16" Height="16" IsActive="True" Visibility="{x:Bind InFlightVisibility, Mode=OneWay}" />
                        <Button Content="Approve" Style="{StaticResource SmallButtonStyle}" Visibility="{x:Bind DecideVisibility, Mode=OneWay}"
                                IsEnabled="{x:Bind Online, Mode=OneWay}" Click="OnApproveClick" />
                        <Button Content="Deny" Style="{StaticResource SmallButtonStyle}" Visibility="{x:Bind DecideVisibility, Mode=OneWay}"
                                IsEnabled="{x:Bind Online, Mode=OneWay}" Click="OnDenyClick" />
                        <TextBlock Text="Decide in the portal" Visibility="{x:Bind PortalVisibility, Mode=OneWay}" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{x:Bind Error, Mode=OneWay}" Visibility="{x:Bind ErrorVisibility, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" IsTextSelectionEnabled="True" Margin="24,0,0,0" />
            </StackPanel>
        </DataTemplate>

        <views:PanelItemTemplateSelector x:Key="ItemSelector" Role="{StaticResource RoleRowTemplate}" Note="{StaticResource NoteRowTemplate}" Approval="{StaticResource ApprovalRowTemplate}" />

        <!-- Group headers: the pinned "Approvals" and "Active now" groups, an account row, or a tenant header. -->
        <DataTemplate x:Key="GroupHeaderTemplate" x:DataType="views:PanelGroup">
            <Grid Padding="10,6,6,6" ColumnSpacing="8" Background="{x:Bind HeaderBrush, Mode=OneWay}"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,1" MinHeight="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource SubtleButtonStyle}" Width="24" Height="24" Click="OnToggleGroup"
                        AutomationProperties.Name="Collapse or expand">
                    <FontIcon Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>
                <!-- The avatar carries the sign-in method as its tooltip; the row's caption is the UPN and tenant. -->
                <Border Grid.Column="1" Width="26" Height="26" CornerRadius="13" Background="{ThemeResource AccentFillColorDefaultBrush}"
                        Visibility="{x:Bind AvatarVisibility, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind SignInHelp, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind SignInHelp, Mode=OneWay}">
                    <TextBlock Text="{x:Bind Initials, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Text="home" Visibility="{x:Bind HomeVisibility, Mode=OneWay}" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <!-- A mode the user chose, not a problem: the neutral tint. -->
                        <views:Pill Text="manual roles" Visibility="{x:Bind ManualVisibility, Mode=OneWay}" Tooltip="Discovery is refused in this tenant; the roles are the ones you configured" />
                        <!-- The box glyph opens the tenant's access packages; shown only when the token carries the entitlement scope. -->
                        <Button Style="{StaticResource SubtleButtonStyle}" Width="22" Height="22" Visibility="{x:Bind AccessPackagesVisibility, Mode=OneWay}"
                                Click="OnAccessPackagesClick" ToolTipService.ToolTip="Access packages" AutomationProperties.Name="Access packages">
                            <FontIcon Glyph="&#xE7B8;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Button>
                        <!-- One glyph for everything that limits the tenant: orange for limitations, red when discovery or refresh failed. Hover for the titles, click for the reasons. -->
                        <Button Style="{StaticResource SubtleButtonStyle}" Width="22" Height="22" Visibility="{x:Bind IssuesVisibility, Mode=OneWay}"
                                Click="OnIssuesClick" ToolTipService.ToolTip="{x:Bind IssuesTooltip, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind IssuesLabel, Mode=OneWay}">
                            <FontIcon Glyph="{x:Bind IssuesGlyph, Mode=OneWay}" FontSize="13" Foreground="{x:Bind IssuesBrush, Mode=OneWay}" />
                        </Button>
                        <ProgressRing Width="14" Height="14" IsActive="True" Visibility="{x:Bind BusyVisibility, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind Caption, Mode=OneWay}" Visibility="{x:Bind CaptionVisibility, Mode=OneWay}" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{x:Bind Caption, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- Secondary text, not green: 13 px green on the light ground falls under 3:1, and the row's status dots already carry the colour. -->
                    <TextBlock Text="{x:Bind ActiveText, Mode=OneWay}" Visibility="{x:Bind ActiveVisibility, Mode=OneWay}"
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind PendingText, Mode=OneWay}" Visibility="{x:Bind PendingVisibility, Mode=OneWay}"
                               FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="4" Style="{StaticResource SubtleButtonStyle}" Width="28" Height="28" Click="OnGroupMenu"
                        Visibility="{x:Bind MenuVisibility, Mode=OneWay}" AutomationProperties.Name="Actions">
                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: title, offline pill, tools -->
        <Grid Grid.Row="0" Padding="14,10,8,4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Elevate" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Grid.Column="1" x:Name="OfflinePill" Visibility="Collapsed" VerticalAlignment="Center"
                    Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="9" Padding="7,1"
                    ToolTipService.ToolTip="No network connection; refreshes and requests are paused">
                <TextBlock Text="offline" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Border>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2">
                <ToggleButton x:Name="SearchToggle" Width="32" Height="32" Padding="0" Click="OnSearchToggle"
                              AutomationProperties.Name="Search">
                    <FontIcon Glyph="&#xE721;" FontSize="14" />
                </ToggleButton>
                <ToggleButton x:Name="SelectToggle" Width="32" Height="32" Padding="0" Click="OnSelectToggle"
                              ToolTipService.ToolTip="Select several roles to activate together" AutomationProperties.Name="Select roles">
                    <FontIcon Glyph="&#xE762;" FontSize="14" />
                </ToggleButton>
                <Button x:Name="RefreshButton" Style="{StaticResource SubtleButtonStyle}" Width="32" Height="32" Padding="0"
                        Click="OnRefresh" AutomationProperties.Name="Refresh">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Pivots: a segmented picker like the macOS panel -->
        <views:SegmentedPivots Grid.Row="1" x:Name="Pivots" Margin="14,2,14,8" SelectionChanged="OnPivotChanged" />

        <!-- Profiles: a chip per pinned profile in one row that never wraps, and "All N" for the rest; hidden when there are none. -->
        <Grid Grid.Row="2" x:Name="ProfilesRow" Visibility="Collapsed" Padding="12,7,12,7" ColumnSpacing="6"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Chip columns are built in code: star-sized and capped, so four chips shrink together instead of wrapping. -->
            <Grid Grid.Column="0" x:Name="ProfileChips" ColumnSpacing="6" />
            <Button Grid.Column="1" x:Name="AllProfiles" Click="OnAllProfiles" Style="{StaticResource SubtleButtonStyle}" Height="28" MinHeight="28" Padding="8,0"
                    ToolTipService.ToolTip="All profiles: search, run, pin and manage">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock x:Name="AllProfilesLabel" Text="All" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    <FontIcon Glyph="&#xE70D;" FontSize="8" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Search -->
        <Grid Grid.Row="3" x:Name="SearchRow" Visibility="Collapsed" Padding="12,4,12,6"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <TextBox x:Name="SearchBox" PlaceholderText="Filter roles" TextChanged="OnSearchChanged" KeyDown="OnSearchKeyDown" />
        </Grid>

        <!-- Notices -->
        <StackPanel Grid.Row="4" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <InfoBar x:Name="OfflineBar" IsOpen="False" IsClosable="False" Severity="Warning" Margin="12,8,12,0"
                     Title="You're offline." Message="Countdowns keep running; refresh and activation resume when the network is back." />
            <InfoBar x:Name="NoticeBar" IsOpen="False" Severity="Warning" Margin="12,8,12,0" Closed="OnNoticeClosed" />
            <InfoBar x:Name="UpdateBar" IsOpen="False" Severity="Informational" Margin="12,8,12,0" Closed="OnUpdateClosed">
                <InfoBar.ActionButton>
                    <Button Content="Open" Click="OnUpdateOpen" />
                </InfoBar.ActionButton>
            </InfoBar>
            <!-- After an Azure or group activation: cached az / kubelogin tokens predate it. Closing hides it for that account. -->
            <InfoBar x:Name="TokenHintBar" IsOpen="False" Severity="Informational" Margin="12,8,12,0" Title="Cached tokens may be stale" Closed="OnTokenHintClosed">
                <InfoBar.ActionButton>
                    <Button x:Name="TokenHintCopy" Content="Copy command" Click="OnTokenHintCopy" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <!-- Body -->
        <Grid Grid.Row="5">
            <!-- First run: no client id and no account yet -->
            <StackPanel x:Name="SetupView" Visibility="Collapsed" Padding="22,18,22,24" Spacing="10" HorizontalAlignment="Stretch">
                <views:ChevronGlyph Width="40" Height="40" HorizontalAlignment="Center" />
                <TextBlock Text="Complete initial setup" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Elevate can sign in with your own Entra app registration, which covers every role type and stays under your control. The Elevate project also offers a shared multi-tenant app for quick starts, with no SLA and an administrator consent step. Microsoft's Azure CLI app needs no registration but covers Azure resource roles only (no Entra roles or groups)."
                           FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <!-- Point first-time users at the guides on GitHub before they pick a route. -->
                <views:DocsLinksRow HorizontalAlignment="Center" />
                <!-- One width for the stacked buttons; the accent on the primary path only. -->
                <StackPanel Spacing="8" HorizontalAlignment="Center" Width="264" Margin="0,4,0,0">
                    <Button Content="Open Settings…" Style="{StaticResource AccentButtonStyle}" Click="OnSettings" HorizontalAlignment="Stretch" />
                    <Button x:Name="QuickStartShared" Click="OnQuickStartShared" HorizontalAlignment="Stretch" />
                    <Button Content="Continue with the Azure CLI app" Click="OnContinueWithCli" HorizontalAlignment="Stretch" />
                </StackPanel>
                <TextBlock x:Name="SetupError" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Visibility="Collapsed"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            </StackPanel>

            <!-- Configured, but nothing added yet -->
            <StackPanel x:Name="NoAccountsView" Visibility="Collapsed" Padding="22,18,22,24" Spacing="8">
                <FontIcon Glyph="&#xE8FA;" FontSize="28" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="No accounts" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Add an account to see your PIM roles." FontSize="13" TextAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <!-- With the shared app in effect, an administrator has to consent once per tenant first. -->
                <StackPanel x:Name="NoAccountsActions" Spacing="8" HorizontalAlignment="Center" Width="264" Margin="0,4,0,0" Visibility="Collapsed">
                    <Button Content="Add account…" Style="{StaticResource AccentButtonStyle}" Click="OnAddAccount" HorizontalAlignment="Stretch" />
                    <Button Content="Grant admin consent…" Click="OnGrantSharedConsent" HorizontalAlignment="Stretch" />
                </StackPanel>
            </StackPanel>

            <ListView x:Name="List" Visibility="Collapsed" SelectionMode="None" IsItemClickEnabled="False"
                      ItemsSource="{x:Bind GroupedSource.View, Mode=OneWay}" ItemTemplateSelector="{StaticResource ItemSelector}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.GroupStyle>
                    <GroupStyle HeaderTemplate="{StaticResource GroupHeaderTemplate}" HidesIfEmpty="False">
                        <GroupStyle.HeaderContainerStyle>
                            <Style TargetType="ListViewHeaderItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}" />
                            </Style>
                        </GroupStyle.HeaderContainerStyle>
                    </GroupStyle>
                </ListView.GroupStyle>
            </ListView>
        </Grid>

        <!-- Select mode: sticky bulk bar -->
        <StackPanel Grid.Row="6" x:Name="BulkBar" Visibility="Collapsed" Padding="14,8,14,10" Spacing="8"
                    Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="BulkCaption" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="BulkHint" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" Visibility="Collapsed" Margin="0,-6,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button x:Name="BulkProfile" Content="Save as profile…" Click="OnBulkProfile" />
                <Button x:Name="BulkActivate" Style="{StaticResource AccentButtonStyle}" Content="Activate" Click="OnBulkActivate" />
            </StackPanel>
        </StackPanel>

        <!-- Footer -->
        <Grid Grid.Row="7" Padding="8,4" Background="{ThemeResource LayerOnMicaBaseAltFillColorSecondaryBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <HyperlinkButton Grid.Column="0" Content="Add account…" Click="OnAddAccount" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <HyperlinkButton Grid.Column="2" x:Name="SettingsButton" Content="Settings…" Click="OnSettings" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <HyperlinkButton Grid.Column="4" Content="Quit" Click="OnQuit" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</UserControl>
