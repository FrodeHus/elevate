<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Elevate.App.Views.RunProfileContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- One boxed group per tenant, each headed by the tenant name with the account as caption. -->
        <ScrollViewer x:Name="RowsScroll" Grid.Row="0" MaxHeight="320" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Rows" Spacing="8" />
        </ScrollViewer>

        <StackPanel Grid.Row="1" x:Name="Inputs" Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <ToggleSwitch x:Name="ScheduleToggle" Header="" OnContent="Start later" OffContent="Start later" Toggled="OnScheduleToggled" MinWidth="0" />
                <DatePicker x:Name="StartDate" Visibility="Collapsed" DateChanged="OnStartChanged" />
                <TimePicker x:Name="StartTime" Visibility="Collapsed" MinuteIncrement="5" TimeChanged="OnStartTimeChanged" />
            </StackPanel>
            <StackPanel Spacing="6">
                <TextBlock Text="Reason" FontSize="13" />
                <TextBox x:Name="Reason" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="120" TextChanged="OnInputChanged"
                         PlaceholderText="Why you need this access" />
            </StackPanel>
            <Grid x:Name="TicketRow" Visibility="Collapsed" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Text="Ticket number" FontSize="13" />
                    <TextBox x:Name="TicketNumber" TextChanged="OnInputChanged" PlaceholderText="Required by policy" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="Ticket system" FontSize="13" />
                    <TextBox x:Name="TicketSystem" TextChanged="OnInputChanged" PlaceholderText="e.g. ServiceNow" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- One segment per requested role, beside the count: colour alone must not carry the result. -->
        <Grid Grid.Row="2" x:Name="ProgressRow" Visibility="Collapsed" ColumnSpacing="8" RowSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="60" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid x:Name="Segments" ColumnSpacing="2" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" x:Name="ProgressText" FontSize="12" TextTrimming="CharacterEllipsis"
                       AutomationProperties.LiveSetting="Polite" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <TextBlock Grid.Row="3" Text="Entries already active or unchecked are skipped. Approval-required entries are requested and shown as pending."
                   FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <InfoBar Grid.Row="4" x:Name="Failure" IsOpen="False" IsClosable="False" Severity="Error" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" TabFocusNavigation="Local">
            <!-- Tab reaches the default button first, although Cancel is drawn first. -->
            <ProgressRing x:Name="Running" Width="20" Height="20" IsActive="False" Visibility="Collapsed" VerticalAlignment="Center" />
            <Button x:Name="CancelButton" TabIndex="1" Content="Cancel" Click="OnCancel" MinWidth="90" />
            <Button x:Name="SubmitButton" TabIndex="0" Content="Activate" Style="{StaticResource AccentButtonStyle}" Click="OnSubmit" MinWidth="120" />
        </StackPanel>
    </Grid>
</UserControl>
