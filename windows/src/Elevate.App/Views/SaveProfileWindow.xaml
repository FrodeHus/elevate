<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Elevate.App.Views.SaveProfileWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Padding="22,6,22,22" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Save as profile" FontSize="18" FontWeight="SemiBold" />
        <TextBox Grid.Row="1" x:Name="NameBox" PlaceholderText="Profile name" TextChanged="OnNameChanged" />
        <Border Grid.Row="2" CornerRadius="4" Padding="10,6" Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Entries" Spacing="2" />
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="OnCancel" MinWidth="90" />
            <Button x:Name="SaveButton" Content="Save" Style="{StaticResource AccentButtonStyle}" Click="OnSave" MinWidth="110" />
        </StackPanel>
    </Grid>
</Window>
