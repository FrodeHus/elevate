<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Elevate.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Elevate.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid x:Name="Root" Padding="22,6,22,22" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Settings" FontSize="18" FontWeight="SemiBold" />

        <!-- App registration -->
        <StackPanel Grid.Row="1" Spacing="8">
            <TextBlock Text="ENTRA APP REGISTRATION" FontSize="11" FontWeight="SemiBold" CharacterSpacing="80" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <StackPanel Spacing="6">
                <TextBlock Text="Application (client) ID" FontSize="13" />
                <!-- Applies on Enter or focus loss like the other settings; no Save button. -->
                <TextBox x:Name="ClientId" PlaceholderText="00000000-0000-0000-0000-000000000000" FontFamily="Cascadia Mono, Consolas"
                         TextChanged="OnClientIdChanged" KeyDown="OnClientIdKeyDown" LostFocus="OnClientIdLostFocus" />
                <TextBlock x:Name="ApplyHint" Text="Press Enter to apply." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                <!-- A managed client id is shown, never edited: the box is disabled and says why. -->
                <StackPanel x:Name="ClientIdManaged" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE825;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Managed by your organization" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <!-- The quick-start route is offered only where the id can actually be changed. -->
                <Button x:Name="QuickStartShared" Click="OnQuickStartShared" HorizontalAlignment="Left" />
                <!-- While the shared id is in effect: name it, and offer the once-per-tenant consent link. -->
                <StackPanel x:Name="SharedAppRow" Spacing="6" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE716;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Shared Elevate app — no SLA" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button Content="Grant admin consent…" Click="OnGrantSharedConsent" HorizontalAlignment="Left" />
                </StackPanel>
            </StackPanel>
            <Grid Padding="14,12" CornerRadius="4" ColumnSpacing="14" Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Redirect URIs" FontWeight="SemiBold" />
                    <TextBlock x:Name="BrokerUri" FontSize="12" FontFamily="Cascadia Mono, Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    <TextBlock x:Name="LoopbackUri" FontSize="12" FontFamily="Cascadia Mono, Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                    <TextBlock x:Name="RedirectCaption" Text="Register both under the Mobile and desktop applications platform, and add the Graph PIM permissions listed in the app registration guide."
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <views:DocsLinksRow Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="1" x:Name="CopyUris" Content="Copy" Click="OnCopyUris" VerticalAlignment="Center" />
            </Grid>
            <InfoBar x:Name="SaveError" IsOpen="False" IsClosable="False" Severity="Error" />
            <TextBlock x:Name="Saved" Text="Saved. Add your accounts from the Elevate flyout." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
        </StackPanel>

        <!-- General -->
        <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock Text="GENERAL" FontSize="11" FontWeight="SemiBold" CharacterSpacing="80" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <Grid Padding="14,12" CornerRadius="4" ColumnSpacing="14" Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Start Elevate when I sign in" FontWeight="SemiBold" />
                    <TextBlock Text="Adds a Run entry for the current user." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="StartupError" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" x:Name="RunAtLogin" OnContent="" OffContent="" MinWidth="0" Toggled="OnRunAtLoginToggled" VerticalAlignment="Center" />
            </Grid>
            <Grid Padding="14,12" CornerRadius="4" ColumnSpacing="14" Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Version" FontWeight="SemiBold" />
                    <TextBlock x:Name="Version" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    <TextBlock x:Name="UpdateMessage" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ProgressRing x:Name="Checking" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                    <Button x:Name="CheckUpdates" Content="Check for updates" Click="OnCheckUpdates" />
                    <TextBlock x:Name="UpdatesManaged" Text="Updates are managed by your organization" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxWidth="220"
                               VerticalAlignment="Center" Visibility="Collapsed" />
                    <HyperlinkButton Content="Release notes" NavigateUri="https://github.com/FrodeHus/elevate/releases" />
                </StackPanel>
            </Grid>
            <Grid Padding="14,12" CornerRadius="4" ColumnSpacing="14" Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Diagnostics" FontWeight="SemiBold" />
                    <TextBlock Text="Copies a report of your accounts, tenants, profiles and recent errors. It never contains tokens or client IDs."
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" x:Name="CopyDiagnostics" Content="Copy diagnostics" Click="OnCopyDiagnostics" VerticalAlignment="Center" />
            </Grid>
        </StackPanel>

        <!-- Global shortcut -->
        <StackPanel Grid.Row="3" Spacing="8">
            <TextBlock Text="GLOBAL SHORTCUT" FontSize="11" FontWeight="SemiBold" CharacterSpacing="80" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <StackPanel Padding="14,12" Spacing="10" CornerRadius="4" Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Shortcut" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <views:HotKeyRecorder x:Name="Recorder" BindingChanged="OnHotKeyChanged" />
                        <Button x:Name="ClearHotKey" Content="Clear" Click="OnClearHotKey" />
                    </StackPanel>
                </Grid>
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Runs profile" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" x:Name="HotKeyProfile" MinWidth="220" SelectionChanged="OnHotKeyProfileChanged" />
                </Grid>
                <TextBlock Text="Runs the profile like Ctrl-clicking its chip; opens the run window if input is needed."
                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <TextBlock x:Name="HotKeyError" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <!-- What the organization pushed, and where it came from. Hidden without a policy. -->
        <StackPanel Grid.Row="4" x:Name="ManagedGroup" Spacing="8" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xE825;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="Managed by your organization" FontSize="11" FontWeight="SemiBold" CharacterSpacing="80"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
            <StackPanel x:Name="ManagedRows" Padding="14,12" Spacing="6" CornerRadius="4" Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" />
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="CloseButton" Content="Close" Click="OnClose" MinWidth="90" />
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>
