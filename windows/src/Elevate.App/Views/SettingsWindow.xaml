<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Elevate.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Padding="22,6,22,22" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Settings" FontSize="18" FontWeight="SemiBold" />

        <!-- App registration -->
        <StackPanel Grid.Row="1" Spacing="8">
            <TextBlock Text="APP REGISTRATION" FontSize="11" FontWeight="SemiBold" CharacterSpacing="80" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <StackPanel Spacing="6">
                <TextBlock Text="Application (client) ID" FontSize="13" />
                <TextBox x:Name="ClientId" PlaceholderText="00000000-0000-0000-0000-000000000000" FontFamily="Cascadia Mono, Consolas" TextChanged="OnClientIdChanged" />
            </StackPanel>
            <Grid Padding="14,12" CornerRadius="4" ColumnSpacing="14" Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Redirect URIs" FontWeight="SemiBold" />
                    <TextBlock x:Name="BrokerUri" FontSize="12" FontFamily="Cascadia Mono, Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    <TextBlock x:Name="LoopbackUri" FontSize="12" FontFamily="Cascadia Mono, Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                    <TextBlock Text="Register both under the Mobile and desktop applications platform, and add the Graph PIM permissions listed in the docs."
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" x:Name="CopyUris" Content="Copy" Click="OnCopyUris" VerticalAlignment="Center" />
            </Grid>
            <InfoBar x:Name="SaveError" IsOpen="False" IsClosable="False" Severity="Error" />
            <TextBlock x:Name="Saved" Text="Saved. Add your accounts from the Elevate flyout." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
        </StackPanel>

        <!-- General -->
        <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock Text="GENERAL" FontSize="11" FontWeight="SemiBold" CharacterSpacing="80" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <Grid Padding="14,12" CornerRadius="4" ColumnSpacing="14" Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Start Elevate when I sign in" FontWeight="SemiBold" />
                    <TextBlock Text="Adds a Run entry for the current user." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="StartupError" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" x:Name="RunAtLogin" OnContent="" OffContent="" MinWidth="0" Toggled="OnRunAtLoginToggled" VerticalAlignment="Center" />
            </Grid>
            <Grid Padding="14,12" CornerRadius="4" ColumnSpacing="14" Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Version" FontWeight="SemiBold" />
                    <TextBlock x:Name="Version" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                </StackPanel>
                <HyperlinkButton Grid.Column="1" Content="Release notes" NavigateUri="https://github.com/FrodeHus/elevate/releases" VerticalAlignment="Center" />
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Close" Click="OnClose" MinWidth="90" />
            <Button x:Name="SaveButton" Content="Save" Style="{StaticResource AccentButtonStyle}" Click="OnSave" MinWidth="110" />
        </StackPanel>
    </Grid>
</Window>
