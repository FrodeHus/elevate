<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Worked example: Contoso's Elevate profile. See README.md in this directory for what it pins.
  Generate fresh PayloadUUIDs with `uuidgen` before deploying a copy of this file.
-->
<plist version="1.0">
<dict>
  <key>PayloadType</key>
  <string>Configuration</string>
  <key>PayloadVersion</key>
  <integer>1</integer>
  <key>PayloadIdentifier</key>
  <string>com.contoso.elevate.managed</string>
  <key>PayloadUUID</key>
  <string>2C8B3B7F-0000-4000-A000-000000000001</string>
  <key>PayloadDisplayName</key>
  <string>Elevate managed settings (Contoso)</string>
  <key>PayloadDescription</key>
  <string>Contoso's managed settings for Elevate.</string>
  <key>PayloadOrganization</key>
  <string>Contoso</string>
  <key>PayloadScope</key>
  <string>System</string>
  <key>PayloadRemovalDisallowed</key>
  <true/>
  <key>PayloadContent</key>
  <array>
    <dict>
      <key>PayloadType</key>
      <string>com.apple.ManagedClient.preferences</string>
      <key>PayloadVersion</key>
      <integer>1</integer>
      <key>PayloadIdentifier</key>
      <string>com.contoso.elevate.managed.preferences</string>
      <key>PayloadUUID</key>
      <string>2C8B3B7F-0000-4000-A000-000000000002</string>
      <key>PayloadDisplayName</key>
      <string>Elevate preferences</string>
      <key>PayloadEnabled</key>
      <true/>
      <key>PayloadContent</key>
      <dict>
        <key>no.reothor.elevate</key>
        <dict>
          <key>Forced</key>
          <array>
            <dict>
              <key>mcx_preference_settings</key>
              <dict>
                <key>ClientId</key>
                <string>11111111-2222-3333-4444-555555555555</string>
                <key>DisableUpdateCheck</key>
                <true/>
                <key>AllowedSignInMethods</key>
                <array>
                  <string>ownApp</string>
                </array>
                <key>AllowedTenants</key>
                <array>
                  <string>contoso.com</string>
                  <string>fabrikam.com</string>
                </array>
                <key>PinnedTenants</key>
                <array>
                  <string>contoso.com</string>
                  <string>fabrikam.com</string>
                </array>
                <key>ManagedProfiles</key>
                <string>{"version":1,"profiles":[{"id":"prod-incident","name":"Prod incident","reason":"Incident response","pinned":true,"roles":[{"kind":"azureResource","tenant":"contoso.com","scope":"/subscriptions/00000000-0000-0000-0000-000000000001","role":"Contributor","duration":"PT2H"},{"kind":"entraDirectory","tenant":"contoso.com","role":"Security Reader"},{"kind":"group","tenant":"contoso.com","group":"SRE on-call","access":"member","duration":"PT4H"}]}]}</string>
                <key>ManagedProfilesUrl</key>
                <string>https://example.com/elevate/profiles.json</string>
              </dict>
            </dict>
          </array>
        </dict>
      </dict>
    </dict>
  </array>
</dict>
</plist>
